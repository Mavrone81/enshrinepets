# Environment for the Enshrine website.
# Copy to ".env" (which is git-ignored) and fill in. In production this lives on
# the droplet at /root/enshrinepets/enshrine-pets-website/.env

NODE_ENV=production

# Port the app listens on (nginx proxies the public domain to this).
PORT=20101

# Secret used to sign admin login sessions. MUST be set in production and kept
# stable, otherwise everyone is logged out on every restart/deploy.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Optional: password for the auto-seeded "admin" account on first run only.
# ADMIN_PASSWORD=change-me
