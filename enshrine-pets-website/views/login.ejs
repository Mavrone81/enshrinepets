<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Login — Enshrine 欣奉</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="login-wrap">
  <div class="login-card">
    <div class="brand">Enshrine <span>欣奉</span></div>
    <div class="sub">Website Admin</div>
    <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.message %></div><% } %>
    <form method="post" action="/admin/login">
      <div class="field">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" autocomplete="username" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required style="width:100%;border:1px solid var(--line);border-radius:9px;padding:10px 12px;font-family:inherit;font-size:.97rem">
      </div>
      <button type="submit" class="btn btn-gold">Log In</button>
    </form>
  </div>
</div>
</body>
</html>
