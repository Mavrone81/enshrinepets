<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/head') %>
</head>
<body>

<%- include('partials/nav') %>

<header class="hero" id="top">
  <div class="container hero-grid">
    <div>
      <img class="hero-logo" src="<%= c.hero.logo %>" alt="Enshrine 欣奉 logo">
      <h1><%= c.hero.headingLead %> <em><%= c.hero.headingEm %></em></h1>
      <p><%= c.hero.paragraph %></p>
      <div class="hero-values">
        <% c.hero.values.forEach(function(v){ %><span><%= v %></span><% }); %>
      </div>
      <a href="<%= c.hero.primaryBtnLink %>" class="btn btn-gold"><%= c.hero.primaryBtnLabel %></a>&nbsp;&nbsp;
      <a href="<%= c.hero.secondaryBtnLink %>" class="btn btn-outline"><%= c.hero.secondaryBtnLabel %></a>
    </div>
    <div class="hero-img-wrap">
      <img src="<%= c.hero.image %>" alt="<%= c.hero.imageAlt %>">
    </div>
  </div>
</header>

<section class="about">
  <div class="container about-grid">
    <div>
      <span class="eyebrow"><%= c.about.eyebrow %></span>
      <h2 class="section-title"><%= c.about.titleLead %> <em><%= c.about.titleEm %></em></h2>
      <div class="gold-rule"></div>
      <p class="lead"><%= c.about.lead %></p>
    </div>
    <div class="about-stats">
      <% c.about.stats.forEach(function(s){ %>
        <div class="stat"><b><%= s.value %></b><span><%= s.label %></span></div>
      <% }); %>
    </div>
  </div>
</section>

<section class="services" id="services">
  <div class="container">
    <span class="eyebrow"><%= c.services.eyebrow %></span>
    <h2 class="section-title"><%= c.services.titleLead %> <em><%= c.services.titleEm %></em></h2>
    <div class="gold-rule"></div>
    <p class="lead"><%= c.services.lead %></p>
    <div class="svc-grid">
      <% c.services.cards.forEach(function(card){ %>
      <div class="svc-card">
        <img src="<%= card.image %>" alt="<%= card.imageAlt %>" loading="lazy" decoding="async">
        <div class="svc-body">
          <h3><%= card.title %></h3>
          <p><%= card.desc %></p>
          <ul>
            <% card.items.forEach(function(it){ %><li><%= it %></li><% }); %>
          </ul>
          <% if (card.link) { %><a class="svc-more" href="<%= card.link %>"><%= card.linkLabel || 'Learn more' %> &rarr;</a><% } %>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="religious" id="religious">
  <div class="container">
    <span class="eyebrow"><%= c.religious.eyebrow %></span>
    <h2 class="section-title"><%= c.religious.titleLead %> <em><%= c.religious.titleEm %></em></h2>
    <div class="gold-rule"></div>
    <p class="lead"><%= c.religious.lead %></p>
    <div class="faith-grid">
      <% c.religious.faiths.forEach(function(f){ %>
        <div class="faith-card"><img src="<%= f.image %>" alt="<%= f.imageAlt %>" loading="lazy" decoding="async"><span><%= f.label %></span></div>
      <% }); %>
    </div>
  </div>
</section>

<section class="colum" id="columbarium">
  <div class="container">
    <div class="colum-grid">
      <img class="building" src="<%= c.columbarium.buildingImage %>" alt="<%= c.columbarium.buildingImageAlt %>" loading="lazy" decoding="async">
      <div>
        <span class="badge"><%= c.columbarium.badge %></span>
        <h2 class="section-title"><%= c.columbarium.titleLead %> <em><%= c.columbarium.titleEm %></em></h2>
        <div class="gold-rule"></div>
        <p class="lead"><%- c.columbarium.lead %></p>
        <div class="feat-list">
          <% c.columbarium.features.forEach(function(ft){ %>
            <div class="feat"><%= ft %></div>
          <% }); %>
        </div>
      </div>
    </div>
    <div class="gallery">
      <% c.columbarium.gallery.forEach(function(g){ %>
        <img src="<%= g.image %>" alt="<%= g.imageAlt %>" loading="lazy" decoding="async">
      <% }); %>
    </div>
  </div>
</section>

<section class="niches" id="niches">
  <div class="container">
    <span class="eyebrow"><%= c.niches.eyebrow %></span>
    <h2 class="section-title"><%= c.niches.titleLead %> <em><%= c.niches.titleEm %></em></h2>
    <div class="gold-rule"></div>
    <% c.niches.rows.forEach(function(row){ %>
    <div class="niche-row<%= row.flip ? ' flip' : '' %>">
      <% if (!row.flip) { %>
        <img src="<%= row.image %>" alt="<%= row.imageAlt %>" loading="lazy" decoding="async">
        <div class="txt">
          <h3><%= row.titleLead %> <span><%= row.titleEm %></span></h3>
          <p><%= row.desc %></p>
        </div>
      <% } else { %>
        <div class="txt">
          <h3><%= row.titleLead %> <span><%= row.titleEm %></span></h3>
          <p><%= row.desc %></p>
        </div>
        <img src="<%= row.image %>" alt="<%= row.imageAlt %>" loading="lazy" decoding="async">
      <% } %>
    </div>
    <% }); %>
  </div>
</section>

<section class="contact" id="contact">
  <div class="container">
    <span class="eyebrow"><%= c.contact.eyebrow %></span>
    <h2 class="section-title"><%= c.contact.titleLead %> <em><%= c.contact.titleEm %></em></h2>
    <div class="gold-rule"></div>
    <div class="contact-grid">
      <div class="contact-card">
        <h3><%= c.contact.cardTitle %></h3>
        <div class="contact-line"><b><%= c.contact.labels.address %></b><span><%= c.contact.address %></span></div>
        <div class="contact-line"><b><%= c.contact.labels.visiting %></b><span><%= c.contact.visiting %></span></div>
        <div class="contact-line"><b><%= c.contact.labels.phone %></b><span><%= c.contact.phone %></span></div>
        <div class="contact-line"><b><%= c.contact.labels.whatsapp %></b><span><%= c.contact.whatsapp %></span></div>
        <div class="contact-line"><b><%= c.contact.labels.email %></b><span><%= c.contact.email %></span></div>
        <a class="btn btn-gold" href="<%= c.contact.btnLink %>"><%= c.contact.btnLabel %></a>
      </div>
      <iframe title="Map to Enshrine Pet Columbarium" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=<%= encodeURIComponent(c.contact.mapQuery) %>&output=embed"></iframe>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
<%- include('partials/floating') %>
<%- include('partials/chatbot') %>

</body>
</html>
