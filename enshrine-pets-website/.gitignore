node_modules/
.env
.DS_Store
npm-debug.log*

# Admin accounts (hashed) — created on first run, never committed
data/users.json

# Live, admin-editable content. Seeded from the *.default.json templates on
# first boot; kept out of git so live admin edits persist across deploys.
data/content.json
data/enquiries.json
data/analytics.json
data/i18n/*.json
!data/i18n/*.default.json

# Uploaded images (admin uploads) — keep the folder, ignore its contents
public/uploads/*
!public/uploads/.gitkeep
